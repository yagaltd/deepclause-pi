+%% boundary_gate(Tasks, Evidence) succeeds with Evidence when the apply diff
+%% escapes the union of declared allowed paths; fails when satisfied or inert.
+boundary_gate(Tasks, Evidence) :-
+    boundary_union(Tasks, Union),
+    Union \= [],
+    boundary_diff(Paths),
+    boundary_violations(Union, Paths, Violations),
+    Violations \= [],
+    atomics_to_string(Violations, ", ", PathsLine),
+    format(string(Evidence), "boundary violation: changed outside allowed paths ~w: ~w", [Union, PathsLine]).
+
+boundary_union(Tasks, Union) :-
+    findall(Pattern, (
+        member(plan_task(_, Props), Tasks),
+        catch(get_dict(allowed, Props, Paths), _, Paths = []),
+        member(Pattern, Paths)
+    ), Union0),
+    sort(Union0, Union).
+
+%% Fetch changed paths since apply start. Degrades loudly (output + fail) when
+%% the command is not approved or git is unavailable — never blocks the task.
+boundary_diff(Paths) :-
+    catch(exec(dc_verify_run(command: "git diff --name-only HEAD; git ls-files --others --exclude-standard"), Dict), Err, Dict = error(Err)),
+    (   Dict = error(Err)
+    ->  format(string(Msg), "boundary: diff unavailable (~w); gate skipped", [Err]),
+        output(Msg), fail
+    ;   get_dict(exitCode, Dict, 0)
+    ->  get_dict(stdout, Dict, Raw),
+        split_string(Raw, "\n", "\r\t ", Paths)
+    ;   get_dict(exitCode, Dict, Code),
+        format(string(Msg), "boundary: git diff exited ~w; gate skipped", [Code]),
+        output(Msg), fail
+    ).
+
+boundary_matches(Path, Pattern) :-
+    sub_string(Pattern, _, 3, 0, "/**"),
+    !,
+    sub_string(Pattern, 0, _, 3, Dir),
+    atomics_to_string([Dir, "/"], Prefix),
+    sub_string(Path, 0, _, _, Prefix).
+boundary_matches(Path, Pattern) :-
+    sub_string(Pattern, _, 2, 0, "/*"),
+    !,
+    sub_string(Pattern, 0, _, 2, Dir),
+    atomics_to_string([Dir, "/"], Prefix),
+    sub_string(Path, 0, _, _, Prefix).
+boundary_matches(Path, Pattern) :-
+    Path == Pattern.
+
+boundary_violations(Union, Paths, Violations) :-
+    findall(Path, (
+        member(Path, Paths),
+        Path \= "",
+        \+ sub_string(Path, 0, _, _, ".pi/deepclause/"),
+        \+ (member(Pattern, Union), boundary_matches(Path, Pattern))
+    ), Violations).
+
