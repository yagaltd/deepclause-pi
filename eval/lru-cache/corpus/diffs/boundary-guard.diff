+%% boundary_gate(Tasks, Evidence) succeeds with Evidence when the apply diff
+%% escapes the union of declared allowed paths; fails when satisfied or inert.
+boundary_gate(Tasks, Evidence) :-
+    boundary_union(Tasks, Union),
+    Union \= [],
+    boundary_diff(Paths),
+    boundary_violations(Union, Paths, Violations),
+    Violations \= [],
+    atomics_to_string(Violations, ", ", PathsLine),
+    format(string(Evidence), "boundary violation: changed outside allowed paths ~w: ~w", [Union, PathsLine]).
+
+boundary_union(Tasks, Union) :-
+    findall(Pattern, (
+        member(plan_task(_, Props), Tasks),
+        catch(get_dict(allowed, Props, Paths), _, Paths = []),
+        member(Pattern, Paths)
+    ), Union0),
+    sort(Union0, Union).
+
+%% Fetch changed paths since apply start. Degrades loudly (output + fail) when
+%% the command is not approved or git is unavailable — never blocks the task.
+boundary_diff(Paths) :-
